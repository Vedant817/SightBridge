{
  "name": "@sightbridge/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "prisma:generate": "prisma generate",
    "deploy:neon": "prisma migrate deploy && pnpm seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1068.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@sightbridge/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.1.1",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "socket.io": "4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.1.0",
    "@types/supertest": "7.2.0",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
