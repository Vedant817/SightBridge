# Local Docker Postgres. For hosted deployment, use Neon free-tier pooled DATABASE_URL.
DATABASE_URL=postgresql://sightbridge:sightbridge@postgres:5432/sightbridge
# Direct unpooled Neon/Postgres URL for migrations. Locally this can match DATABASE_URL.
DIRECT_URL=postgresql://sightbridge:sightbridge@postgres:5432/sightbridge
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
INVITE_SECRET=replace-with-another-32-random-characters
CORS_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MEDIA_URL=http://localhost:5000
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sightbridge
LOCAL_STORAGE_DIR=/data/sightbridge
RECORDINGS_DIR=/data/sightbridge/recordings
SEED_AGENT_EMAIL=agent@sightbridge.local
SEED_AGENT_PASSWORD=password123
ANNOUNCED_IP=127.0.0.1

# Optional TURN server for restrictive NATs, for example: turn:turn.example.com:3478?transport=udp
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Media guardrails
MAX_PRODUCERS_PER_ROOM=8
MAX_CONSUMERS_PER_SOCKET=16
MEDIA_SOCKET_EVENT_LIMIT_PER_MINUTE=120
EMPTY_ROOM_CLEANUP_MS=60000
RECONNECT_GRACE_MS=30000
